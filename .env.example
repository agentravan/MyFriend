# Required: login passphrase for your private NOVA
NOVA_PASSPHRASE=choose-a-long-passphrase
# LLM brain (free tiers). Groq is primary; Gemini is fallback (never receives your memory/ledger).
GROQ_API_KEY=        # https://console.groq.com/keys
GEMINI_API_KEY=      # https://aistudio.google.com/apikey
# Optional model pins
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
